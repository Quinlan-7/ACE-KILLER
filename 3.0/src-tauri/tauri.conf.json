{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACE-KILLER",
  "version": "3.0.0",
  "identifier": "com.zhouzdx.ace-killer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ACE-KILLER v3.0",
        "width": 900,
        "height": 680,
        "minWidth": 700,
        "minHeight": 500,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
